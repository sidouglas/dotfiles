{
  "servers": {
    "asana": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "https://mcp.asana.com/v2/mcp",
        "3334",
        "--static-oauth-client-info",
        "{\"client_id\": \"${env:ASANA_MCP_CLIENT_ID}\", \"client_secret\": \"${env:ASANA_MCP_CLIENT_SECRET}\"}",
        "--resource",
        "https://mcp.asana.com/v2",
      ],
      "env": {
        "ASANA_MCP_CLIENT_ID": "${env:ASANA_MCP_CLIENT_ID}",
        "ASANA_MCP_CLIENT_SECRET": "${env:ASANA_MCP_CLIENT_SECRET}",
      },
    },
    "com.figma.mcp/mcp": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp",
      "gallery": "https://registry.modelcontextprotocol.io",
      "version": "1.0.3",
    },
    "io.github.ChromeDevTools/chrome-devtools-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--registry",
        "https://registry.npmjs.org",
        "chrome-devtools-mcp@0.20.2",
      ],
      "gallery": "https://registry.modelcontextprotocol.io",
      "version": "0.20.2",
    },
  },
}
