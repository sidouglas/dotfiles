{
  "search": {
    "include_ignored": true
  },
  "gutter": {
    "line_numbers": true
  },
  "minimap": {
    "show": "never"
  },
  "cursor_shape": "bar",
  "cursor_blink": false,
  "buffer_font_fallbacks": [
    "Fira Code",
    "Monaco",
    "Courier New",
    "monospace"
  ],
  "show_whitespaces": "none",
  "semantic_tokens": "off",
  "ensure_final_newline_on_save": true,
  "hard_tabs": false,
  "tab_size": 2,
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "session": {
    "trust_all_worktrees": true
  },
  "icon_theme": "Zed (Default)",
  "which_key": {
    "enabled": true
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "git_panel": {
    "dock": "left"
  },
  "prettier": {
    "allowed": true
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_menus": true
  },
  "tabs": {
    "git_status": true
  },
  "git": {
    "inline_blame": {
      "enabled": false,
      "show_commit_summary": true
    }
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "default": "allow"
    },
    "play_sound_when_agent_done": "always",
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4"
    },
    "default_model": {
      "model": "claude-sonnet-4",
      "provider": "zed.dev"
    },
    "model_parameters": []
  },
  "base_keymap": "VSCode",
  "buffer_font_family": "Hack Nerd Font",
  "buffer_font_size": 14,
  "collaboration_panel": {
    "dock": "right"
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "file_scan_exclusions": [
    "**/.DS_Store",
    "**/.git",
    "**/.hg",
    "**/.svn",
    "**/CVS",
    "**/Thumbs.db",
    "**/node_modules",
    ".history",
    "**/.classpath",
    "**/.husky",
    "**/.next",
    "**/.nyc_output",
    "**/.settings",
    "**/.storybook",
    "**/.tap",
    "**/.turbo",
    "**/.vscode",
    "**/.vscode-test",
    "**/dist",
    "**/out",
    "**/report"
  ],
  "format_on_save": "on",
  "formatter": [{ "code_action": "source.fixAll.eslint" }, "prettier"],
  "indent_guides": {
    "coloring": "indent_aware",
    "enabled": true
  },
  "languages": {
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      },
      "formatter": "language_server"
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      },
      "formatter": "language_server"
    }
  },
  "linked_edits": true,
  "outline_panel": {
    "dock": "right"
  },
  "project_panel": {
    "auto_fold_dirs": false,
    "auto_reveal_entries": true,
    "button": true,
    "default_width": 300,
    "dock": "right",
    "entry_spacing": "comfortable",
    "file_icons": true,
    "git_status": true,
    "indent_guides": {
      "show": "always"
    },
    "indent_size": 2,
    "scrollbar": {
      "git_diff": true,
      "show": "never"
    },
    "folder_indicator": "icon"
  },
  "relative_line_numbers": "enabled",
  "scrollbar": {
    "git_diff": true,
    "show": "never"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "shell": {
      "program": "zsh"
    }
  },
  "theme": {
    "dark": "Ayu Dark",
    "light": "One Light",
    "mode": "dark"
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true
  },
  "ui_font_family": "Hack Nerd Font Mono",
  "ui_font_size": 14,
  "vim": {
    "use_system_clipboard": "always"
  },
  "vim_mode": true,
  "wrap_guides": [90]
}
