#!/bin/bash

# Get PR number from argument or current branch
if [ -z "$1" ]; then
  PR_NUMBER=$(git num 2>/dev/null)

  if [ $? -ne 0 ] || [ -z "$PR_NUMBER" ]; then
    echo "Usage: git pr-feedback <PR-number> [output-file]"
    echo "Example: git pr-feedback 17421"
    echo "Example: git pr-feedback 17421 ~/Desktop/custom-feedback.md"
    echo ""
    echo "Error: No PR number provided and couldn't find PR for current branch"
    exit 1
  fi

  echo "Using current branch's PR #$PR_NUMBER"
else
  PR_NUMBER=$1
fi

OUTPUT_FILE=${2:-~/Desktop/feedback-$PR_NUMBER.md}

# Infer repo owner/name from git remote
REPO=$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null)
if [ -z "$REPO" ]; then
  echo "Error: Could not determine repository from current directory."
  echo "Make sure you're inside a git repository with a GitHub remote."
  exit 1
fi

echo "Fetching feedback for $REPO PR #$PR_NUMBER..."

OWNER=$(echo "$REPO" | cut -d'/' -f1)
NAME=$(echo "$REPO" | cut -d'/' -f2)

gh api graphql \
  -F owner="$OWNER" \
  -F name="$NAME" \
  -F pr="$PR_NUMBER" \
  -f query='
    query($owner: String!, $name: String!, $pr: Int!) {
      repository(owner: $owner, name: $name) {
        pullRequest(number: $pr) {
          reviewThreads(first: 100) {
            nodes {
              isResolved
              comments(first: 50) {
                nodes {
                  databaseId
                  path
                  line
                  author { login }
                  body
                }
              }
            }
          }
        }
      }
    }' \
  --jq '.data.repository.pullRequest.reviewThreads.nodes | reverse | .[] | select(.isResolved | not) | select(any(.comments.nodes[]; .body | startswith("Fixed in ")) | not) | .comments.nodes[0] | "## \(.path) (Line \(.line))\n**Author:** \(.author.login)\n**Comment ID:** \(.databaseId)\n\n\(.body)\n\n---\n"' \
  > "$OUTPUT_FILE"

echo "Feedback saved to: $OUTPUT_FILE"

# Copy message to clipboard
echo "we have received feedback on this branch and must make changes: $OUTPUT_FILE. After committing each fix, reply to the corresponding reviewer comment with the format \`Fixed in <HASH> - <short description>\` using: gh api repos/$REPO/pulls/$PR_NUMBER/comments -f body=\"Fixed in <HASH> - <description>\" -F in_reply_to=<COMMENT_ID>. Each fix is 1 commit. All fixes are pushed when the entire task is done." | pbcopy

echo "✓ Message copied to clipboard!"
