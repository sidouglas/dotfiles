#!/usr/bin/env bash
# wt-pr: create a wezterm tab with a 3-pane layout (half left, two quarters stacked right),
# titled with a colour emoji and an optional PR number and/or label.
#
# Usage: wt-pr <green|yellow|red|blue|purple> [pr-number] [label]
#   wt-pr yellow              -> 🟡 <current-branch>
#   wt-pr yellow 12345        -> 🟡 12345           (checks out PR 12345)
#   wt-pr yellow "foo bar"    -> 🟡 foo bar         (current branch)
#   wt-pr yellow 12345 "foo bar" -> 🟡 12345: foo bar (checks out PR 12345)

set -euo pipefail

# pane we were launched from — closed at the end once the new tab is up
orig_pane="${WEZTERM_PANE:-}"

usage() {
  echo "usage: $(basename "$0") <green|yellow|red|blue|purple> [pr-number] [label]" >&2
  exit 2
}

[[ $# -ge 1 && $# -le 3 ]] || usage

color="$1"
shift

pr=""
label=""
if [[ $# -ge 1 && "$1" =~ ^[0-9]+$ ]]; then
  pr="$1"
  shift
fi
if [[ $# -ge 1 ]]; then
  label="$1"
  shift
fi
[[ $# -eq 0 ]] || usage

case "$color" in
  green)  emoji="🟢"; project="$HOME/github/streem/frontend" ;;
  blue)   emoji="🔵"; project="$HOME/github/streem/frontend-blue" ;;
  yellow) emoji="🟡"; project="$HOME/github/streem/frontend-yellow" ;;
  purple) emoji="🟣"; project="$HOME/github/streem/frontend-purple" ;;
  red)    emoji="🔴"; project="$HOME/github/streem/backend/api" ;;
  *) usage ;;
esac

command -v wezterm >/dev/null || { echo "wezterm not on PATH" >&2; exit 1; }
[[ -n "$pr" ]] && { command -v gh >/dev/null || { echo "gh not on PATH" >&2; exit 1; }; }

[[ -d "$project" ]] || { echo "project path does not exist: $project" >&2; exit 1; }

cd "$project"

git rev-parse --git-dir >/dev/null 2>&1 || { echo "$project is not a git repo" >&2; exit 1; }

if [[ -n "$pr" ]]; then
  pr_branch=$(gh pr view "$pr" --json headRefName -q .headRefName)
  [[ -n "$pr_branch" ]] || { echo "could not resolve branch for PR #$pr" >&2; exit 1; }

  current_branch=$(git branch --show-current)
  if [[ "$current_branch" != "$pr_branch" ]]; then
    if [[ -n "$(git status --porcelain)" ]]; then
      echo "$project is dirty — commit or stash before running $(basename "$0")" >&2
      exit 1
    fi
    gh pr checkout "$pr"
  fi

  if [[ -n "$label" ]]; then
    title="${emoji} ${pr}: ${label}"
  else
    title="${emoji} ${pr}"
  fi
else
  if [[ -n "$label" ]]; then
    title="${emoji} ${label}"
  else
    current_branch=$(git branch --show-current)
    [[ -n "$current_branch" ]] || { echo "$project is in detached HEAD — check out a branch first" >&2; exit 1; }
    title="${emoji} ${current_branch}"
  fi
fi

cwd="$project"

left=$(wezterm cli spawn --cwd "$cwd")
tab_id=$(wezterm cli list | awk -v p="$left" '$3==p {print $2; exit}')

[[ -n "$tab_id" ]] || { echo "could not resolve tab id for pane $left" >&2; exit 1; }

wezterm cli set-tab-title --tab-id "$tab_id" "$title"

right_top=$(wezterm cli split-pane --pane-id "$left" --cwd "$cwd" --right --percent 50)
wezterm cli split-pane --pane-id "$right_top" --cwd "$cwd" --bottom --percent 50 >/dev/null

wezterm cli activate-tab --tab-id "$tab_id"

# close the tab we were launched from — it's no longer needed
if [[ -n "$orig_pane" && "$orig_pane" != "$left" ]]; then
  wezterm cli kill-pane --pane-id "$orig_pane" >/dev/null 2>&1 || true
fi
