# Aliases
# ══════════════════════════════════════════════════════════
# als <pattern> — find matching aliases AND functions (case-insensitive).
# No args lists everything. See a function's body with:  functions <name>
als() {
  emulate -L zsh
  local q="$*"
  print -P "%F{cyan}── aliases ──%f"
  alias | grep -i -- "$q"
  print -P "%F{cyan}── functions ──%f"
  print -l -- ${(ko)functions} | grep -v '^_' | grep -i -- "$q"
}
