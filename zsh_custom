# Utility functions
# ══════════════════════════════════════════════════════════
function mkcd() { mkdir -p "$@" && cd "$_"; }
function trash () { command mv "$@" ~/.Trash ; }

# open file/dir (or cwd if no arg)
function oo() {
  if [ -z "$1" ]; then
    open .
  else
    open "$1"
  fi
}

# set a file's creation date — setdate "MM/DD/YYYY HH:MM:SS" "filename"
setdate() {
    if [ $# -ne 2 ]; then
        echo "Usage: setdate \"MM/DD/YYYY HH:MM:SS\" \"filename\""
        echo "Example: setdate \"05/26/2026 00:00:00\" \"myfile.pdf\""
        return 1
    fi
    SetFile -d "$1" "$2"
}

# sort a JSON file in place by key
jq_sort() {
    local input_file="$1"
    if [[ -z "$input_file" ]]; then
        echo "Usage: jq_sort <input_file>"
        return 1
    fi

    local temp_file=$(mktemp)
    jq -S '.' "$input_file" > "$temp_file" && mv "$temp_file" "$input_file"
}

# generate a QR code PNG — qr "https://example.com" [out.png]
qr() {
    if [[ -z "$1" ]]; then
        echo "usage: qr <text> [output.png]"
        return 1
    fi
    qrencode -o "${2:-code.png}" "$1" -s 8
}

# kill every process whose name matches the argument
function killname() {
  if [ "$1" = "" ]; then
     echo "Nothing to do"
  else
    ps -ej | grep "$1"
    ps -ej | grep "$1" | awk '{print $2}' | xargs kill -s SIGINT
  fi
}

# kill whatever is listening on a port — kp 3000
function kp (){ kill -9 $(lsof -i:"$1" -t); }

# edit ~/.zsh_history in vim, or `zh -pattern` to strip matching lines
function zh() {
  if [[ "$1" == "-"* && "$1" != "" ]]; then
    pattern="${1#-}"
    grep -v "$pattern" ~/.zsh_history > ~/.zsh_history.tmp && mv ~/.zsh_history.tmp ~/.zsh_history
    echo "Removed entries containing '$pattern' from ~/.zsh_history"
  else
    command vim ~/.zsh_history
  fi
}

# remove all history lines containing a string
function hist_remove() {
    local search_string="$1"
    if [[ -z "$search_string" ]]; then
        echo "Please provide a search string."
        return 1
    fi

    local temp_file=$(mktemp)
    grep -v "$search_string" ~/.zsh_history > "$temp_file"
    mv "$temp_file" ~/.zsh_history
    echo "Lines containing '$search_string' have been removed from ~/.zsh_history"
}

# ══════════════════════════════════════════════════════════
# YouTube / yt-dlp
# ══════════════════════════════════════════════════════════
# Default download location for the helpers below
export YTDL_DIR="$HOME/Downloads"

# Bare passthrough — best merged quality, sensible defaults
alias yt='yt-dlp -o "$YTDL_DIR/%(title)s.%(ext)s"'
# Update / housekeeping (installed via brew, so upgrade through brew)
alias ytup='brew upgrade yt-dlp'
alias ytv='yt-dlp --version'
# List available formats for a URL
alias ytf='yt-dlp -F'

# Best-quality video + audio muxed into an mp4
function ytmp4() {
  yt-dlp -f 'bv*+ba/b' --merge-output-format mp4 \
    -o "$YTDL_DIR/%(title)s.%(ext)s" "$@"
}

# Audio only → mp3, best quality, with metadata + embedded cover art
# -f ba overrides the global config's video format so no video is fetched
function ytmp3() {
  yt-dlp -f 'ba/bestaudio/best' -x --audio-format mp3 --audio-quality 0 \
    --embed-metadata --embed-thumbnail \
    -o "$YTDL_DIR/%(title)s.%(ext)s" "$@"
}

# Best audio in its ORIGINAL codec (opus/m4a) — no re-encoding, no quality loss
function ytaudio() {
  yt-dlp -f 'ba/bestaudio/best' -x --audio-quality 0 \
    --embed-metadata --embed-thumbnail \
    -o "$YTDL_DIR/%(title)s.%(ext)s" "$@"
}

# Full-fat: best mp4 with subs, chapters, metadata and thumbnail embedded
function ytfull() {
  yt-dlp -f 'bv*+ba/b' --merge-output-format mp4 \
    --embed-subs --embed-metadata --embed-thumbnail --embed-chapters \
    --sub-langs "en.*" \
    -o "$YTDL_DIR/%(title)s.%(ext)s" "$@"
}

# Download a whole playlist into its own folder, numbered
function ytpl() {
  yt-dlp -f 'bv*+ba/b' --merge-output-format mp4 \
    -o "$YTDL_DIR/%(playlist_title)s/%(playlist_index)02d - %(title)s.%(ext)s" "$@"
}

# Playlist as mp3 audio into its own folder
function ytplmp3() {
  yt-dlp -f 'ba/bestaudio/best' -x --audio-format mp3 --audio-quality 0 \
    --embed-metadata --embed-thumbnail \
    -o "$YTDL_DIR/%(playlist_title)s/%(playlist_index)02d - %(title)s.%(ext)s" "$@"
}

# Cap resolution, e.g.  yt1080 <url>  /  yt720 <url>
function yt1080() { yt-dlp -f 'bv*[height<=1080]+ba/b[height<=1080]' --merge-output-format mp4 -o "$YTDL_DIR/%(title)s.%(ext)s" "$@" }
function yt720()  { yt-dlp -f 'bv*[height<=720]+ba/b[height<=720]'   --merge-output-format mp4 -o "$YTDL_DIR/%(title)s.%(ext)s" "$@" }
